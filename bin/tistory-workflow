#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_PYTHON="$ROOT_DIR/.venv/bin/python"
TARGET_SCRIPT="$ROOT_DIR/scripts/tistory_nlm_workflow.py"

if [[ ! -x "$VENV_PYTHON" ]]; then
  echo "ERROR: repo venv is missing. Run 'python3 -m venv .venv' and 'pip install -r requirements.txt' first." >&2
  exit 1
fi

exec "$VENV_PYTHON" "$TARGET_SCRIPT" "$@"
